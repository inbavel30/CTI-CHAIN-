{
  "type": "object",
  "required": [
    "fact_id",
    "status",
    "report_id",
    "page",
    "sentence_id",
    "text",
    "certainty",
    "source_type"
  ],
  "properties": {
    "fact_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "GOLD",
        "REVIEW",
        "REJECTED"
      ]
    },
    "annotator_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string",
      "pattern": "^R\\d{3}$"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "paragraph_id": {
      "type": "string"
    },
    "sentence_id": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence_start": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_end": {
      "type": "integer",
      "minimum": 1
    },
    "certainty": {
      "enum": [
        "EXPLICIT",
        "INFERRED",
        "UNCERTAIN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_type": {
      "const": "CTI_REPORT"
    }
  }
}