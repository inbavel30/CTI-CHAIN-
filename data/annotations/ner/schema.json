{
  "type": "object",
  "required": [
    "annotation_id",
    "status",
    "report_id",
    "sentence_id",
    "text",
    "entities"
  ],
  "properties": {
    "annotation_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "GOLD",
        "REVIEW",
        "REJECTED"
      ]
    },
    "annotator_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string",
      "pattern": "^R\\d{3}$"
    },
    "sentence_id": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "entity_id",
          "text",
          "label",
          "start",
          "end"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "enum": [
              "GROUP",
              "MALWARE",
              "TOOL",
              "SOFTWARE",
              "TECHNIQUE",
              "VULNERABILITY",
              "IP",
              "DOMAIN",
              "FILE",
              "ORGANIZATION",
              "LOCATION",
              "DATE"
            ]
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}